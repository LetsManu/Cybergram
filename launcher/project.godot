; Cybergram launcher: a separate small Godot project (not part of the game).
; Godot ignores this folder when importing/exporting the root project because
; it contains its own project.godot.
config_version=5

[application]

config/name="Cybergram Launcher"
config/version="1.6.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=false
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
