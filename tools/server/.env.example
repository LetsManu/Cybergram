# Copy to ".env" next to docker-compose.yml. Every line is optional; the value
# shown is the default. See docs/HOSTING.md.

# "front" (default): one process per match. "single": the pre-v0.13 server
# (rollback; ratings, queues and the draft are then not available).
CYBERGRAM_MODE=front

# Address clients are told to connect to for a match: your DynDNS name or the
# VPS domain / public IP. Empty = the address the client used to reach 7777.
CYBERGRAM_PUBLIC_HOST=

# UDP port range for match processes, one port per concurrent match. Must
# equal the compose mapping (7800-7809) and your router / firewall rules.
CYBERGRAM_MATCH_PORTS=7800-7809

# Concurrent matches. 0 = 2 per CPU core, never more than the port range.
# About 190 MiB RAM each. NAS: 2-4.
CYBERGRAM_MAX_MATCHES=0

# Join ticket keys, "kid:hex", comma separated; the first is the active one.
# Generate:  echo "k1:$(openssl rand -hex 32)"
# Empty = a random key at every start (fine on one host). Treat as a secret;
# never commit your real .env.
CYBERGRAM_TICKET_KEYS=

# Host folder with fullchain.pem and privkey.pem for encrypted login.
# NAS: /srv/cybergram/tls. Default ./tls next to the compose file.
CYBERGRAM_TLS_DIR=./tls

# Message of the day shown in the launcher (plain text, max 200 characters),
# a path INSIDE the container (the data volume).
CYBERGRAM_MOTD_FILE=/data/motd.txt
